#!/usr/bin/env bash
# upower-sanity — catch upower latching a bogus full-capacity value.
#
# Why this exists: on 2026-08-26 upowerd reported energy-full = 720.4 Wh for a
# 71.8 Wh battery (10.04x), which made the desktop show 8% when the real charge
# was ~75%. The kernel's own numbers were correct the entire time; only upower
# was wrong, and `systemctl restart upower` fixed it instantly.
#
# Exit 0 = sane. Exit 1 = divergent (and, with --fix, upower was restarted).

set -uo pipefail
B=/sys/class/power_supply/BAT0
[ -d "$B" ] || { echo "no BAT0"; exit 0; }

read_u() { cat "$B/$1" 2>/dev/null || echo 0; }
cf=$(read_u charge_full); vmd=$(read_u voltage_min_design)
[ "$vmd" -eq 0 ] && vmd=$(read_u voltage_now)
[ "$cf" -eq 0 ] || [ "$vmd" -eq 0 ] && { echo "kernel values unavailable"; exit 0; }

kernel_wh=$(awk -v c="$cf" -v v="$vmd" 'BEGIN{printf "%.2f", (c/1e6)*(v/1e6)}')
up_wh=$(upower -i "$(upower -e | grep -m1 BAT)" 2>/dev/null \
        | awk '/energy-full:/{print $2}')
[ -z "${up_wh:-}" ] && { echo "upower not reporting"; exit 0; }

ratio=$(awk -v a="$up_wh" -v b="$kernel_wh" 'BEGIN{printf "%.3f", a/b}')
ok=$(awk -v r="$ratio" 'BEGIN{print (r>0.8 && r<1.25) ? 1 : 0}')

if [ "$ok" -eq 1 ]; then
  echo "OK  upower=${up_wh}Wh kernel=${kernel_wh}Wh ratio=${ratio}"
  exit 0
fi

echo "DIVERGENT  upower=${up_wh}Wh kernel=${kernel_wh}Wh ratio=${ratio}"
if [ "${1:-}" = "--fix" ]; then
  systemctl restart upower && echo "restarted upower"
fi
exit 1
